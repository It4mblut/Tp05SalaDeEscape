<h1>@ViewBag.textoPista</h1>

<form action='@Url.Action("responderAcertijo", "Home")' method="post">
    <input type="hidden" name="numeroAcertijo" value="@ViewBag.numeroDialogo">
    <input type="hidden" name="recompensa" value="@ViewBag.juego.dicRecompensas[@ViewBag.numeroDialogo]">

    <input type="text" name="respuestaUsuario">
    <input type="submit" name="" id="" value="answer">
</form>

<form action='@Url.Action("volverASala", "Home")' method="post">
    <input type="submit" name="" id="" value="return">
</form>